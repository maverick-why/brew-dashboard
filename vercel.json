{
  "builds": [
    {
      "src": "brewops/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    { "src": "api/*.js",         "use": "@vercel/node" },
    { "src": "api/brewops/*.js", "use": "@vercel/node" },
    { "src": "api/cron/*.js",    "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/brewops",             "headers": { "Location": "/brewops/" }, "status": 301 },
    { "src": "/brewops/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/brewops/(.*)",        "dest": "/index.html" },
    { "src": "/api/cup/verify",      "dest": "/api/cup" },
    { "src": "/api/cup/claim",       "dest": "/api/cup" },
    { "src": "/api/cup/admin",       "dest": "/api/cup" },
    { "src": "/api/cup/sync-members","dest": "/api/cup" },
    { "src": "/claimyourtap",        "dest": "/claimyourtap.html" },
    { "src": "/class(/?)",           "dest": "/class.html" },
    { "src": "/(.*)",                "dest": "/$1" }
  ],
  "crons": [
    { "path": "/api/cron/sponsor-expiry", "schedule": "0 2 * * *" }
  ]
}
